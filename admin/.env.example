# Local dev: leave empty to use the vite proxy → http://localhost:3001
# Production (Vercel): set to your deployed API URL
VITE_API_URL=

# Image uploads (Cloudinary, free tier) — enables the Upload button
# on the product form. Without these, the form falls back to URL-only.
# 1. https://cloudinary.com → Dashboard → copy "Cloud name"
# 2. Settings → Upload → Upload presets → Add → Signing Mode = Unsigned
#    → name it e.g. "styleverse" → Save → copy the preset name
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=styleverse
