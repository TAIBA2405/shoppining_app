# Copy to .env and fill in (never commit .env)
# Neon dashboard → your project → Connection string (pooled, -pooler host)
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.neon.tech/shop?sslmode=require"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=3001
# Set to true once so the admin account is created on first boot
SEED_ADMIN=true
# Frontend/Admin origins (comma-separated) — optional, defaults to *
# CLIENT_URLS="https://your-store.vercel.app,https://your-admin.vercel.app"
# Small pool for Neon free + Vercel serverless
PG_POOL_MAX=5
